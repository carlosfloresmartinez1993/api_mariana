ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/empresas
# Generar con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres-hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Orígenes del frontend, en formato JSON (solo si el frontend está en otro dominio)
CORS_ORIGINS=[]
LOGIN_RATE_LIMIT=5/minute
DOCS_ENABLED=true
TIMEZONE=America/Tijuana

# Superusuario: se crea al arrancar la API si no existe.
# Contraseña de al menos 8 caracteres, con letras y números.
SUPERUSUARIO_CORREO=super@empresa.com
SUPERUSUARIO_PASSWORD=cambia123
SUPERUSUARIO_NOMBRE=Superusuario
# true = volver a asignar SUPERUSUARIO_PASSWORD (y el correo) en cada arranque; para recuperar el acceso.
SUPERUSUARIO_RESTABLECER=false

# true = cargar datos de demostración al arrancar el contenedor (solo si la base no tiene empresas).
# Local: python -m app.seed
SEED_DEMO=false

# Facturas de entradas y salidas: local (carpeta) o s3 (Cloudflare R2, Supabase Storage, Railway Buckets, AWS S3)
ALMACENAMIENTO=local
ARCHIVOS_DIR=./archivos
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIJO=
# MAX_DOCUMENTO_MB=5
