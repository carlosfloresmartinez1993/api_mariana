# URL del backend para el proxy de desarrollo (vite.config.ts)
BACKEND_URL=http://localhost:8000

# URL base de la API que usa el navegador. En desarrollo se deja /api (pasa por el proxy).
# En producción, si el frontend y la API están en dominios distintos, poner la URL completa
# y agregar el dominio del frontend a CORS_ORIGINS en el backend.
VITE_API_URL=/api
